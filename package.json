{
  "name": "bmm-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run scripts/test-all.ts",
    "test:parallel": "bun run --filter '*' test",
    "test:core": "bun run --filter '@bmm/core' test",
    "test:shared": "bun run --filter '@bmm/shared' test",
    "test:api": "bun run --filter '@bmm/api' test",
    "test:web": "bun run --filter '@bmm/web' test",
    "sim": "bun run --filter '@bmm/api' sim --",
    "demo": "bun run --filter '@bmm/api' demo",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:up": "docker compose up -d 2>/dev/null || docker-compose up -d",
    "db:down": "docker compose down 2>/dev/null || docker-compose down",
    "db:reset": "bun run --filter '@bmm/api' db:reset",
    "db:migrate": "bun run --filter '@bmm/api' db:migrate",
    "db:seed": "bun run --filter '@bmm/api' db:seed",
    "db:seed:markets": "bun run --filter '@bmm/api' db:seed:markets"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.3"
  }
}
