{
  "name": "@bmm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --isolate --env-file=../../.env --timeout=20000",
    "sim": "bun src/sim/runner.ts",
    "demo": "bun --env-file=../../.env src/scripts/demo.ts",
    "db:generate": "drizzle-kit generate",
    "db:reset": "bun --env-file=../../.env src/db/reset.ts",
    "db:migrate": "bun --env-file=../../.env src/db/migrate.ts",
    "db:seed": "bun --env-file=../../.env src/db/seed.ts",
    "db:seed:markets": "bun --env-file=../../.env src/db/seedMarkets.ts"
  },
  "dependencies": {
    "@bmm/core": "workspace:*",
    "@bmm/shared": "workspace:*",
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/jwt": "^1.1.1",
    "@elysiajs/swagger": "^1.1.6",
    "drizzle-orm": "^0.38.3",
    "elysia": "^1.1.26",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.3"
  }
}
