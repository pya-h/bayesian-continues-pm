# --- Database ---
# Point this at any Postgres you have. A Prisma-style `?schema=public` suffix is OK
# (the DB layer strips it and sets the search_path).
DATABASE_URL=postgresql://user:pass@localhost:5432/bmm_db

# Only needed if you use the OPTIONAL docker-compose Postgres (`bun run db:up`).
# Set POSTGRES_PORT to a free host port if 5432 is already taken.
POSTGRES_USER=bmm
POSTGRES_PASSWORD=bmm
POSTGRES_DB=bmm
POSTGRES_PORT=5432

# --- Auth ---
JWT_SECRET=change-me-in-prod-please-use-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-password-change-me

# --- API server ---
PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- BMM engine ---
RESERVE_MC_SAMPLES=50000
RESERVE_ALPHA=0.99

# --- Web client (Vite) ---
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
