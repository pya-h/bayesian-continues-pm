# --- Database ---
DATABASE_URL=postgres://bmm:bmm@localhost:5432/bmm
# values used by docker-compose to provision the dev database
POSTGRES_USER=bmm
POSTGRES_PASSWORD=bmm
POSTGRES_DB=bmm
POSTGRES_PORT=5432

# --- Auth ---
JWT_SECRET=change-me-in-prod-please-use-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-password-change-me

# --- API server ---
PORT=3000
WEB_ORIGIN=http://localhost:5173

# --- BMM engine ---
RESERVE_MC_SAMPLES=50000
RESERVE_ALPHA=0.99

# --- Web client (Vite) ---
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
